{
  "1":{"class_type":"CheckpointLoaderSimple","inputs":{"ckpt_name":"REPLACE_WITH_AVAILABLE_SDXL_CHECKPOINT.safetensors"},"_meta":{"title":"必须替换成云端可用的普通 SDXL checkpoint"}},
